@page
@{
    ViewData["Title"] = "ngrok";
}

<div class="space-y-6">
    <section class="grid gap-4 lg:grid-cols-3">
        <div class="rounded-2xl border border-slate-800 bg-slate-900/70 p-5 lg:col-span-2">
            <div class="mb-5 flex flex-wrap items-center justify-between gap-3">
                <div>
                    <p class="text-sm text-slate-400">Public tunnel</p>
                    <h2 class="text-xl font-semibold">ngrok Gateway</h2>
                </div>
                <span id="statusBadge" class="rounded-full border border-slate-700 bg-slate-800 px-3 py-1 text-xs text-slate-300">Checking...</span>
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
                <div class="rounded-xl border border-slate-800 bg-slate-950/70 p-4">
                    <p class="text-xs uppercase tracking-wider text-slate-500">Public URL</p>
                    <a id="publicUrl" class="mt-2 block break-all text-sm text-emerald-400 hover:underline" target="_blank" rel="noreferrer">Not connected</a>
                </div>
                <div class="rounded-xl border border-slate-800 bg-slate-950/70 p-4">
                    <p class="text-xs uppercase tracking-wider text-slate-500">Service status</p>
                    <p id="statusText" class="mt-2 break-words text-sm text-slate-300">Checking...</p>
                </div>
            </div>
        </div>

        <div class="rounded-2xl border border-slate-800 bg-slate-900/70 p-5">
            <h2 class="text-base font-semibold">Tunnel control</h2>
            <label for="port" class="mt-4 block text-sm text-slate-400">Target port</label>
            <input id="port" type="number" min="1" max="65535" value="5050"
                   class="mt-2 w-full rounded-xl border border-slate-700 bg-slate-950 px-4 py-3 text-base outline-none focus:border-emerald-500" />

            <div class="mt-4 grid grid-cols-2 gap-3">
                <button id="startButton" type="button" class="min-h-11 rounded-xl bg-emerald-500 px-4 py-3 text-sm font-semibold text-slate-950 hover:bg-emerald-400">Start</button>
                <button id="stopButton" type="button" class="min-h-11 rounded-xl border border-slate-700 bg-slate-800 px-4 py-3 text-sm font-semibold hover:bg-slate-700">Stop</button>
            </div>
            <p id="actionMessage" class="mt-3 min-h-5 text-sm text-slate-400" aria-live="polite"></p>
        </div>
    </section>

    <section class="rounded-2xl border border-slate-800 bg-slate-900/70 p-5">
        <div class="flex flex-wrap items-start justify-between gap-3">
            <div>
                <h2 class="text-base font-semibold">Authentication token</h2>
                <p class="mt-1 text-sm text-slate-400">Stored by the ngrok CLI in its normal config file. The panel does not display the saved token.</p>
            </div>
        </div>
        <div class="mt-4 flex flex-col gap-3 sm:flex-row">
            <input id="token" type="password" autocomplete="off" placeholder="Paste ngrok authtoken"
                   class="min-w-0 flex-1 rounded-xl border border-slate-700 bg-slate-950 px-4 py-3 text-base outline-none focus:border-emerald-500" />
            <button id="saveTokenButton" type="button" class="min-h-11 rounded-xl border border-emerald-500/40 bg-emerald-500/10 px-5 py-3 text-sm font-semibold text-emerald-300 hover:bg-emerald-500/20">Save token</button>
        </div>
    </section>

    <section class="rounded-2xl border border-slate-800 bg-slate-900/70 p-5">
        <div class="flex flex-wrap items-center justify-between gap-3">
            <div>
                <h2 class="text-base font-semibold">Logs</h2>
                <p class="mt-1 text-sm text-slate-400">Latest runit/svlogd output from ngrok.</p>
            </div>
            <button id="refreshLogsButton" type="button" class="min-h-11 rounded-xl border border-slate-700 bg-slate-800 px-4 py-2 text-sm hover:bg-slate-700">Refresh</button>
        </div>
        <pre id="logs" class="mt-4 max-h-[32rem] overflow-auto whitespace-pre-wrap break-words rounded-xl border border-slate-800 bg-black/40 p-4 text-xs leading-5 text-slate-300">Loading...</pre>
    </section>
</div>

@section Scripts {
<script>
(() => {
    const statusBadge = document.getElementById('statusBadge');
    const statusText = document.getElementById('statusText');
    const publicUrl = document.getElementById('publicUrl');
    const actionMessage = document.getElementById('actionMessage');
    const logs = document.getElementById('logs');
    const port = document.getElementById('port');

    async function getJson(url, options) {
        const response = await fetch(url, options);
        const body = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error(body.message || body.error || `Request failed (${response.status})`);
        return body;
    }

    async function refreshStatus() {
        try {
            const data = await getJson('/api/ngrok/status');
            statusText.textContent = data.status || 'Unknown';
            statusBadge.textContent = data.running ? 'Running' : 'Stopped';
            statusBadge.className = data.running
                ? 'rounded-full border border-emerald-500/30 bg-emerald-500/10 px-3 py-1 text-xs text-emerald-300'
                : 'rounded-full border border-slate-700 bg-slate-800 px-3 py-1 text-xs text-slate-300';

            if (data.publicUrl) {
                publicUrl.textContent = data.publicUrl;
                publicUrl.href = data.publicUrl;
            } else {
                publicUrl.textContent = data.running ? 'Waiting for tunnel URL...' : 'Not connected';
                publicUrl.removeAttribute('href');
            }
        } catch (error) {
            statusBadge.textContent = 'Unavailable';
            statusText.textContent = error.message;
        }
    }

    async function refreshLogs() {
        try {
            const response = await fetch('/api/ngrok/logs?lines=200');
            logs.textContent = await response.text();
        } catch (error) {
            logs.textContent = error.message;
        }
    }

    document.getElementById('saveTokenButton').addEventListener('click', async () => {
        const token = document.getElementById('token');
        actionMessage.textContent = 'Saving token...';
        try {
            const data = await getJson('/api/ngrok/token', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ token: token.value })
            });
            token.value = '';
            actionMessage.textContent = data.message;
        } catch (error) {
            actionMessage.textContent = error.message;
        }
    });

    document.getElementById('startButton').addEventListener('click', async () => {
        const value = Number(port.value);
        if (!Number.isInteger(value) || value < 1 || value > 65535) {
            actionMessage.textContent = 'Enter a valid port from 1 to 65535.';
            return;
        }
        actionMessage.textContent = 'Starting ngrok...';
        try {
            const data = await getJson('/api/ngrok/start', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ port: value })
            });
            actionMessage.textContent = data.message;
            await new Promise(resolve => setTimeout(resolve, 1000));
            await Promise.all([refreshStatus(), refreshLogs()]);
        } catch (error) {
            actionMessage.textContent = error.message;
        }
    });

    document.getElementById('stopButton').addEventListener('click', async () => {
        actionMessage.textContent = 'Stopping ngrok...';
        try {
            const data = await getJson('/api/ngrok/stop', { method: 'POST' });
            actionMessage.textContent = data.message;
            await Promise.all([refreshStatus(), refreshLogs()]);
        } catch (error) {
            actionMessage.textContent = error.message;
        }
    });

    document.getElementById('refreshLogsButton').addEventListener('click', refreshLogs);
    refreshStatus();
    refreshLogs();
    setInterval(refreshStatus, 5000);
})();
</script>
}
