@page
@{
    ViewData["Title"] = "Terminal";
}

<section class="space-y-4">
    <div class="rounded-2xl border border-slate-800 bg-black p-3 shadow-2xl">
        <div class="mb-3 flex items-center justify-between border-b border-slate-800 pb-3">
            <div class="flex items-center gap-2 text-xs text-slate-400">
                <span id="status-dot" class="h-2 w-2 rounded-full bg-slate-600"></span>
                <span id="status-text">Ready</span>
            </div>
            <button id="cancel" type="button" disabled
                    class="rounded-lg border border-rose-500/30 px-3 py-1 text-xs text-rose-300 disabled:cursor-not-allowed disabled:opacity-40">
                Stop
            </button>
        </div>

        <div id="output" class="h-[55vh] overflow-auto whitespace-pre-wrap break-words font-mono text-sm leading-6 text-emerald-300">TermuxHost shell\nStreaming output with SSE.\n\n</div>

        <form id="shell-form" class="mt-3 flex items-center gap-2 border-t border-slate-800 pt-3">
            <span class="font-mono text-emerald-400">$</span>
            <input id="command" autocomplete="off" autofocus
                   class="min-w-0 flex-1 bg-transparent font-mono text-sm text-slate-100 outline-none placeholder:text-slate-600"
                   placeholder="dotnet --info" />
            <button class="rounded-lg bg-emerald-500 px-4 py-2 text-sm font-semibold text-slate-950">Run</button>
        </form>
    </div>

    <p class="text-xs text-amber-300">This shell allows arbitrary commands. Keep TermuxHost on a trusted LAN until authentication is added.</p>
</section>

@section Scripts {
<script>
const form = document.getElementById('shell-form');
const input = document.getElementById('command');
const output = document.getElementById('output');
const cancelButton = document.getElementById('cancel');
const statusDot = document.getElementById('status-dot');
const statusText = document.getElementById('status-text');
const HISTORY_KEY = 'termuxhost.terminal.history';
const HISTORY_LIMIT = 100;
const history = loadHistory();
let historyIndex = history.length;
let controller = null;

function loadHistory() {
    try {
        const value = JSON.parse(localStorage.getItem(HISTORY_KEY) || '[]');
        return Array.isArray(value) ? value.filter(x => typeof x === 'string').slice(-HISTORY_LIMIT) : [];
    } catch {
        return [];
    }
}

function saveHistory() {
    try {
        localStorage.setItem(HISTORY_KEY, JSON.stringify(history.slice(-HISTORY_LIMIT)));
    } catch {
        // Terminal still works if storage is unavailable.
    }
}

function addHistory(command) {
    if (history[history.length - 1] !== command) {
        history.push(command);
        if (history.length > HISTORY_LIMIT) history.shift();
        saveHistory();
    }
    historyIndex = history.length;
}

function append(text) {
    output.textContent += text;
    output.scrollTop = output.scrollHeight;
}

function setRunning(running) {
    input.disabled = running;
    cancelButton.disabled = !running;
    statusText.textContent = running ? 'Running' : 'Ready';
    statusDot.className = running
        ? 'h-2 w-2 rounded-full bg-emerald-400 animate-pulse'
        : 'h-2 w-2 rounded-full bg-slate-600';
}

function handleEvent(eventName, json) {
    let payload;
    try {
        payload = JSON.parse(json);
    } catch {
        append(json + '\n');
        return false;
    }

    if (eventName === 'stdout') {
        append(payload.data + '\n');
    } else if (eventName === 'stderr') {
        append(payload.data + '\n');
    } else if (eventName === 'error') {
        append(`[error] ${payload.data}\n`);
    } else if (eventName === 'exit') {
        append(`[exit ${payload.data}]\n\n`);
        return true;
    }

    return false;
}

async function streamCommand(command) {
    controller = new AbortController();
    setRunning(true);

    const url = `/api/shell/stream?command=${encodeURIComponent(command)}`;
    const response = await fetch(url, {
        method: 'GET',
        headers: { 'Accept': 'text/event-stream' },
        cache: 'no-store',
        signal: controller.signal
    });

    if (!response.ok || !response.body) {
        throw new Error(await response.text() || `HTTP ${response.status}`);
    }

    const reader = response.body.getReader();
    const decoder = new TextDecoder();
    let buffer = '';
    let finished = false;

    while (!finished) {
        const { value, done } = await reader.read();
        if (done) break;

        buffer += decoder.decode(value, { stream: true });
        const frames = buffer.split(/\r?\n\r?\n/);
        buffer = frames.pop() || '';

        for (const frame of frames) {
            if (!frame.trim()) continue;

            let eventName = 'message';
            const dataLines = [];

            for (const line of frame.split(/\r?\n/)) {
                if (line.startsWith('event:')) {
                    eventName = line.substring(6).trim();
                } else if (line.startsWith('data:')) {
                    dataLines.push(line.substring(5).trimStart());
                }
            }

            if (dataLines.length) {
                finished = handleEvent(eventName, dataLines.join('\n')) || finished;
            }
        }
    }
}

form.addEventListener('submit', async (event) => {
    event.preventDefault();
    const command = input.value.trim();
    if (!command || controller) return;

    addHistory(command);
    append(`$ ${command}\n`);
    input.value = '';

    try {
        await streamCommand(command);
    } catch (error) {
        if (error.name === 'AbortError') {
            append('[cancelled]\n\n');
        } else {
            append(`Request failed: ${error.message || error}\n\n`);
        }
    } finally {
        controller = null;
        setRunning(false);
        input.focus();
    }
});

cancelButton.addEventListener('click', () => {
    controller?.abort();
});

input.addEventListener('keydown', (event) => {
    if (event.key === 'ArrowUp' && history.length) {
        event.preventDefault();
        historyIndex = Math.max(0, historyIndex - 1);
        input.value = history[historyIndex];
        input.setSelectionRange(input.value.length, input.value.length);
    }
    if (event.key === 'ArrowDown' && history.length) {
        event.preventDefault();
        historyIndex = Math.min(history.length, historyIndex + 1);
        input.value = historyIndex === history.length ? '' : history[historyIndex];
        input.setSelectionRange(input.value.length, input.value.length);
    }
});
</script>
}
